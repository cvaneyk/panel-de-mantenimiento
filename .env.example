# Copia este archivo a .env y rellena los valores desde
# supabase.com → Project Settings → API / Database.
#
# La service_role key nunca debe llegar al navegador: solo se usa en n8n y en
# el propio servidor (Server Components, scripts de migración).

SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
